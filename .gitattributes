# Normalize all text to LF in the repo; check out LF on every platform.
# (The original repo had mixed CRLF/LF; the rebuild standardizes on LF.)
* text=auto eol=lf

*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.csv  text eol=lf

# Binary assets — never normalize or diff as text.
*.pt        binary
*.pth       binary
*.onnx      binary
*.pkl       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
